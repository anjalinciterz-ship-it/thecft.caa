# Installed by the host on every build; committing it ships Windows binaries
# (esbuild.exe, rollup.win32-*.node, a .bin/vite cmd shim with no +x) and the
# deploy then dies with "sh: 1: vite: Permission denied".
node_modules/

# Local environment and secrets
.env
.env.*
*.local

# Editor and OS noise
.DS_Store
Thumbs.db
npm-debug.log*
yarn-error.log*
*.log
.eslintcache

# Screenshots the browser harnesses write on every run
tests/browser/shots/

# The audiobooks live in /media at the repo root and belong in git exactly once,
# there. `npm run stage:media` repeats them into dist for a self-hosted deploy,
# and that copy is what must never be committed.
dist/media/
